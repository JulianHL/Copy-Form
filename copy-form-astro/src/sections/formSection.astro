---
import Form from "../components/form.astro";
import GeneralInput from "../components/generalInput.astro";
import Button from "../components/button.astro";
import SelectBox from "../components/selectBox.astro";
import Choice from "../components/choice.astro";
---

<section class="flex justify-center">
  <div class="w-[60%] h-screen">
    <Form>
      <input
        type="radio"
        id="radioYes"
        name="radioGroup"
        value="Yes"
        class="peer/a hidden"
      />
      <input
        type="radio"
        id="radioNo"
        name="radioGroup"
        value="No"
        class="peer/b hidden"
      />

      <SelectBox id="slectBox1" label="example" required={true}>
        <label for="radioYes" class="w-full h-full"
          ><option value="Yes">Yes</option></label
        >
        <label for="radioNo" class="w-full h-full"
          ><option selected value="No">No</option></label
        >
      </SelectBox>

      <div class="hidden peer-checked/a:block">
        <GeneralInput placeholder="Another example" required={false} />
      </div>
      <GeneralInput placeholder="Another example" required={false} />
      <GeneralInput placeholder="Another example" required={false} />
      <GeneralInput placeholder="Another example" required={false} />
      <GeneralInput placeholder="Another example" required={false} />
      <GeneralInput placeholder="Another example" required={false} />
      <GeneralInput placeholder="Another example" required={false} />
      <Choice>
        <span class="dark:text-dark!">Rental</span>
        <input type="checkbox" class="hidden" checked />
      </Choice>

      <Button
        colorHover="var(--color-copy)"
        colorHoverDark="var(--color-copy-dark)"
        ><submit id="copy-button" class="dark:text-dark!"
          >Copy <i class="fa-solid fa-copy dark:before:text-dark!"></i></submit
        ></Button
      >
      <Button
        colorHover="var(--color-delete)"
        colorHoverDark="var(--color-delete-dark)"
        ><submit id="clear-button" class="dark:text-dark!"
          >Clear <i class="fa-solid fa-trash-can dark:before:text-dark!"
          ></i></submit
        ></Button
      >
      <SelectBox id="slectBox1" label="example" required={true}>
        <label for="radioYes" class="w-full h-full"
          ><option value="Yes">Yes</option></label
        >
        <label for="radioNo" class="w-full h-full"
          ><option selected value="No">No</option></label
        >
      </SelectBox>
    </Form>
  </div>
</section>
