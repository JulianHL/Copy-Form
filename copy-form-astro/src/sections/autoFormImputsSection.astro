---
import TelInput from "../components/telInput.astro";
import EmailInput from "../components/emailInput.astro";
import GeneralInput from "../components/generalInput.astro";
import SelectBox from "../components/selectBox.astro";
import DateInput from "../components/dateInput.astro";
import TimeInput from "../components/timeInput.astro";
---

<div
  class="grid grid-cols-1 gap-10 shadow-[5px_5px_10px_var(--shadow-color),-5px_-5px_10px_var(--light-color)]
         dark:shadow-[5px_5px_10px_var(--shadow-color-dark),-5px_-5px_10px_var(--light-color-dark)] p-10! rounded-2xl"
>
  <TelInput id="telBoxAuto" placeholder="phone number" required={true} />
  <EmailInput id="emailBoxAuto" placeholder="email address" required={false} />
  <GeneralInput
    id="generalBoxAutoVehicle"
    placeholder="vehicle"
    capitalized={true}
    required={true}
  />
  <GeneralInput
    id="generalBoxAutoColor"
    placeholder="vehicle color"
    capitalized={true}
    required={true}
  />
  <GeneralInput
    id="generalBoxAutoPlate"
    placeholder="vehicle plate #"
    capitalized={true}
    required={true}
  />
  <SelectBox id="selectBoxAutoInjuries" label="Injuries" required={true}>
    <option value="No">No</option>
    <option value="Yes">Yes</option>
  </SelectBox>

  <div id="selectBoxAutoABContainer" class="hidden">
    <SelectBox
      id="selectBoxAutoAB"
      label="Accident Benefits (A/B)"
      required={true}
    >
      <option value="No">No</option>
      <option value="Yes">Yes</option>
    </SelectBox>
  </div>

  <SelectBox
    id="selectBoxAutoLocation"
    label="current vehicle location"
    required={true}
  >
    <option value="Scene of the accident">Scene of the accident</option>

    <option value="Insured's address">Insured's address</option>

    <option value="Repair Shop">Repair shop</option>

    <option value="Tow yard">Tow yard</option>

    <option value="Collision Center">Collision center</option>

    <option value="Other Location">Other Location</option>
  </SelectBox>
  <SelectBox
    id="selectBoxAutoDrivable"
    label="vehicle drivable?"
    required={true}
  >
    <option value="Yes">Yes</option>
    <option value="No">No</option>
  </SelectBox>
  <GeneralInput
    id="generalBoxAutoCurrentLocation"
    placeholder="current vehicle location address"
    required={true}
  />
</div>

<div
  class="grid grid-cols-1 gap-10 shadow-[5px_5px_10px_var(--shadow-color),-5px_-5px_10px_var(--light-color)]
         dark:shadow-[5px_5px_10px_var(--shadow-color-dark),-5px_-5px_10px_var(--light-color-dark)] p-10! rounded-2xl"
>
  <SelectBox
    id="selectBoxAutoCommercial"
    label="vehicle used for any commercial purposes?"
    required={true}
  >
    <option value="No">No</option>
    <option value="Yes">Yes</option>
  </SelectBox>
  <SelectBox
    id="selectBoxAutoDashCam"
    label="any dash camera footage?"
    required={true}
  >
    <option value="No">No</option>
    <option value="Yes">Yes</option>
  </SelectBox>

  <SelectBox id="selectBoxAutoWitness" label="any witness?" required={true}>
    <option value="No">No</option>
    <option value="Yes">Yes</option>
  </SelectBox>

  <div id="selectBoxAutoWitnessContainer" class="grid-cols-1 gap-10 hidden">
    <GeneralInput
      id="generalBoxAutoWitnessName"
      placeholder="witness name"
      required={false}
    />
    <TelInput
      id="telBoxAutoWitness"
      placeholder="witness phone number"
      required={false}
    />
  </div>

  <SelectBox id="selectBoxAutoSeats" label="baby seats?" required={true}>
    <option value="No">No</option>
    <option value="Yes">Yes</option>
  </SelectBox>

  <SelectBox
    id="selectBoxAutoDrugs"
    label="alcohol, medication or drugs?"
    required={true}
  >
    <option value="No">No</option>
    <option value="Yes">Yes</option>
  </SelectBox>

  <SelectBox
    id="selectBoxAutoRestriction"
    label="any license restrictions?"
    required={true}
  >
    <option value="No">No</option>
    <option value="Yes">Yes</option>
  </SelectBox>

  <div id="selectBoxAutoRestrictionContainer" class="hidden">
    <GeneralInput
      id="generalBoxAutoRestriction"
      name="restrictions"
      placeholder="restrictions"
      required={true}
    />
  </div>

  <div class="grid grid-cols-1 gap-10">
    <SelectBox
      id="selectBoxAutoDevice"
      label="anti-theft device?"
      required={true}
    >
      <option value="No">No</option>
      <option value="Yes">Yes</option>
    </SelectBox>
  </div>

  <SelectBox id="selectBoxAutoThirdParty" label="third-party?" required={true}>
    <option value="No">No</option>

    <option value="Yes">Yes</option>
  </SelectBox>

  <div id="selectBoxAutoThirdPartyReasonContainer" class="block">
    <GeneralInput
      id="generalBoxAutoThirdPartyReason"
      name="thirdPartyReason"
      placeholder="reason for excluding third-party"
      required={true}
    />
  </div>
  <div id="selectBoxAutoThirdPartyContainer" class="grid-cols-1 gap-10 hidden">
    <GeneralInput
      id="generalBoxAutoThirdPartyName"
      name="thirdPartyName"
      placeholder="third-party name"
      capitalized={true}
      required={false}
    />
    <TelInput
      id="generalBoxAutoThirdPartyTel"
      placeholder="third-party phone number"
      required={false}
    />
    <GeneralInput
      id="generalBoxAutoThirdPartyLicense"
      placeholder="third-party license #"
      capitalized={true}
      required={false}
    />
    <GeneralInput
      id="generalBoxAutoThirdPartyInsurance"
      placeholder="third-party insurance"
      capitalized={true}
      required={false}
    />
    <GeneralInput
      id="generalBoxAutoThirdPartyInsurancePolicy"
      placeholder="third-party insurance policy #"
      capitalized={true}
      required={false}
    />
    <GeneralInput
      id="generalBoxAutoThirdPartyVehicle"
      placeholder="third-party vehicle"
      capitalized={true}
      required={false}
    />
    <GeneralInput
      id="generalBoxAutoThirdPartyVehicleColor"
      placeholder="third-party vehicle color"
      capitalized={true}
      required={false}
    />
    <GeneralInput
      id="generalBoxAutoThirdPartyVehiclePlate"
      placeholder="third-party vehicle plate #"
      capitalized={true}
      required={false}
    />
  </div>
  <SelectBox id="selectBoxAutoPolice" label="Police reported?" required={true}>
    <option value="No">No</option>

    <option value="Yes">Yes</option>
  </SelectBox>

  <div id="selectBoxAutoPoliceContainer" class="grid-cols-1 gap-10 hidden">
    <GeneralInput
      id="generalBoxAutoPoliceReport"
      placeholder="police report #"
      required={false}
    />
    <GeneralInput
      id="generalBoxAutoPoliceBadge"
      placeholder="police badge #"
      required={false}
    />
    <TelInput
      id="generalBoxAutoPoliceContact"
      placeholder="police contact info"
      required={false}
    />
    <GeneralInput
      id="generalBoxAutoPoliceCity"
      placeholder="jurisdiction city"
      required={false}
    />
  </div>
</div>
<div
  class="grid grid-cols-1 gap-10 shadow-[5px_5px_10px_var(--shadow-color),-5px_-5px_10px_var(--light-color)]
         dark:shadow-[5px_5px_10px_var(--shadow-color-dark),-5px_-5px_10px_var(--light-color-dark)] p-10! rounded-2xl"
>
  <GeneralInput
    id="generalBoxAutoADJ"
    placeholder="Claim assigned to ADJ"
    required={true}
  />
</div>

<div
  class="grid grid-cols-1 gap-10 shadow-[5px_5px_10px_var(--shadow-color),-5px_-5px_10px_var(--light-color)]
         dark:shadow-[5px_5px_10px_var(--shadow-color-dark),-5px_-5px_10px_var(--light-color-dark)] p-10! rounded-2xl"
>
  <SelectBox
    id="selectBoxAutoService"
    label="Services offered?"
    required={true}
  >
    <option value="Yes">Yes</option>
    <option value="No">No</option>
  </SelectBox>

  <div id="selectBoxAutoServiceReasonContainer" class="hidden">
    <GeneralInput
      id="generalBoxAutoNoServiceReason"
      placeholder="reason for no services offered"
      required={true}
    />
  </div>
  <div id="selectBoxAutoServiceContainer" class="grid-cols-1 gap-10 hidden">
    <input
      type="checkbox"
      id="checkboxBodyShop"
      name="checkboxBodyShop"
      checked
      class="peer/bodyshop hidden"
    />
    <div
      class="h-20 dark:shadow-[0.5rem_0.5rem_1rem_var(--shadow-color-dark),-0.5rem_-0.5rem_1rem_var(--light-color-dark)] peer-checked/bodyshop:dark:shadow-[inset_0_5px_4px_var(--shadow-color-dark),0_3px_2px_var(--light-color-dark)] shadow-[5px_5px_10px_var(--shadow-color),-5px_-5px_10px_var(--light-color)] peer-checked/bodyshop:shadow-[inset_0_5px_4px_var(--shadow-color),0_3px_2px_var(--light-color)] rounded-2xl"
    >
      <label
        for="checkboxBodyShop"
        class="h-full w-full flex items-center font-bold p-5! relative cursor-pointer"
      >
        <span class="dark:text-dark!">Preferred Body Shop</span>
      </label>
    </div>
    <input
      type="checkbox"
      id="checkboxTow"
      name="checkboxTow"
      class="peer/tow hidden"
    />
    <div
      class="h-20 dark:shadow-[0.5rem_0.5rem_1rem_var(--shadow-color-dark),-0.5rem_-0.5rem_1rem_var(--light-color-dark)] peer-checked/tow:dark:shadow-[inset_0_5px_4px_var(--shadow-color-dark),0_3px_2px_var(--light-color-dark)] shadow-[5px_5px_10px_var(--shadow-color),-5px_-5px_10px_var(--light-color)] peer-checked/tow:shadow-[inset_0_5px_4px_var(--shadow-color),0_3px_2px_var(--light-color)] rounded-2xl"
    >
      <label
        id="checkboxTowLabel"
        for="checkboxTow"
        class="h-full w-full flex items-center font-bold p-5! relative cursor-pointer"
      >
        <span class="dark:text-dark!">Tow Assistance</span>
      </label>
    </div>
    <input
      type="checkbox"
      id="checkboxRental"
      name="checkboxRental"
      class="peer/rental hidden"
    />
    <div
      class="h-20 dark:shadow-[0.5rem_0.5rem_1rem_var(--shadow-color-dark),-0.5rem_-0.5rem_1rem_var(--light-color-dark)] peer-checked/rental:dark:shadow-[inset_0_5px_4px_var(--shadow-color-dark),0_3px_2px_var(--light-color-dark)] shadow-[5px_5px_10px_var(--shadow-color),-5px_-5px_10px_var(--light-color)] peer-checked/rental:shadow-[inset_0_5px_4px_var(--shadow-color),0_3px_2px_var(--light-color)] rounded-2xl"
    >
      <label
        id="checkboxRentalLabel"
        for="checkboxRental"
        class="h-full w-full flex items-center font-bold p-5! relative cursor-pointer"
      >
        <span class="dark:text-dark!">Rental</span>
      </label>
    </div>
    <div class="peer-checked/bodyshop:grid grid-cols-1 gap-10 hidden">
      <SelectBox
        id="selectBoxBodyShopAccepted"
        label="Body shop accepted?"
        required={true}
      >
        <option value="Yes">Yes</option>
        <option value="No">No</option>
      </SelectBox>
      <div
        id="selectBoxBodyShopAcceptedContainer"
        class="grid-cols-2 gap-5 hidden"
      >
        <DateInput
          id="dateBoxBodyShopAppointment"
          placeholder="date"
          required={true}
        />
        <TimeInput
          id="timeBoxBodyShopAppointment"
          placeholder="time"
          required={true}
        />
      </div>
    </div>
    <div
      id="towInputsContainer"
      class="peer-checked/tow:grid grid-cols-1 gap-10 hidden"
    >
      <GeneralInput
        id="generalBoxTowAgent"
        placeholder="tow agent name"
        required={true}
      />
      <GeneralInput
        id="generalBoxTowDestination"
        placeholder="tow destination (drop off)"
        required={true}
      />
      <TelInput id="telBoxTow" placeholder="tow phone number" required={true} />
      <GeneralInput
        id="generalBoxTowKeys"
        placeholder="Where are the vehicle keys?"
        required={true}
      />
    </div>
    <div class="peer-checked/rental:grid grid-cols-1 gap-10 hidden">
      <GeneralInput
        id="generalBoxRentalLocation"
        placeholder="rental company location"
        required={true}
      />
    </div>
    <div
      id="generalBoxAutoShopRejectedReasonContainer"
      class="peer-checked/bodyshop:hidden block"
    >
      <GeneralInput
        id="generalBoxAutoShopRejectedReason"
        placeholder="reason for Body shop rejection"
        required={true}
      />
    </div>
    <div class="peer-checked/tow:hidden block">
      <GeneralInput
        id="generalBoxAutoTowRejectedReason"
        placeholder="reason for tow rejection"
        required={true}
      />
    </div>
    <div class="peer-checked/rental:hidden block">
      <GeneralInput
        id="generalBoxAutoRentalRejectedReason"
        placeholder="reason for rental rejection"
        required={true}
      />
    </div>
  </div>
</div>
<script>
  import {
    autoFormConfigSelectDisplay,
    autoFormConfigSelectType,
    autoFormConfigSelectDisable,
  } from "../scripts/autoFormConfig";
  import { targetElementDisplayer } from "../scripts/targetElementDisplayer";
  import { targetElementTyper } from "../scripts/targetElementTyper";
  import { targetElementDisabler } from "../scripts/targetElementDisabler";

  targetElementDisplayer(autoFormConfigSelectDisplay);
  targetElementTyper(autoFormConfigSelectType);
  targetElementDisabler(autoFormConfigSelectDisable);
</script>
