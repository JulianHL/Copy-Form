---
import Button from "../components/button.astro";
import AutoFormImputsSection from "./autoFormImputsSection.astro";
---

<section class="flex justify-center">
  <div class="w-[60%] h-screen">
    <form id="autoForm" class="w-full grid grid-cols-1 gap-20 p-10!">
      <AutoFormImputsSection />
      <div class="flex gap-10">
        <div class="w-60 h-20">
          <Button
            id="copyButton"
            type="button"
            colorHover="var(--color-copy)"
            colorHoverDark="var(--color-copy-dark)"
            ><submit id="copy-button" class="dark:text-dark!"
              >Copy <i class="fa-solid fa-copy dark:before:text-dark!"
              ></i></submit
            ></Button
          >
        </div>

        <div class="w-60 h-20">
          <Button
            id="clearButton"
            type="reset"
            colorHover="var(--color-delete)"
            colorHoverDark="var(--color-delete-dark)"
            ><span id="clear-button" class="dark:text-dark!"
              >Clear <i class="fa-solid fa-trash-can dark:before:text-dark!"
              ></i></span
            ></Button
          >
        </div>
      </div>
    </form>
  </div>
</section>

<script>
  import { requiredInputSwitch } from "../scripts/requiredInputSwitch";
  import { autoFormater } from "../scripts/autoFormater";

  const form = document.getElementById("autoForm") as HTMLFormElement;
  const copyButton = document.getElementById("copyButton") as HTMLElement;

  form.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      copyButton.click();
    }
  });

  form.addEventListener("submit", (e) => {
    console.log("sent");
    e.preventDefault();
    const data = new FormData(form);
    const finalFormat = autoFormater(data);
    console.log(finalFormat);
  });

  copyButton.addEventListener("click", (e) => {
    e.preventDefault();
    console.log("click!");
    requiredInputSwitch();
    form.requestSubmit();
  });
</script>
