---
const { choice = "", checkBoxId = "", label = "" } = Astro.props;
---

<div
  class=`h-20 dark:shadow-[0.5rem_0.5rem_1rem_var(--shadow-color-dark),-0.5rem_-0.5rem_1rem_var(--light-color-dark)] peer-checked/${choice}:dark:shadow-[inset_0_5px_4px_var(--shadow-color-dark),0_3px_2px_var(--light-color-dark)] shadow-[5px_5px_10px_var(--shadow-color),-5px_-5px_10px_var(--light-color)] peer-checked/${choice}:shadow-[inset_0_5px_4px_var(--shadow-color),0_3px_2px_var(--light-color)] rounded-2xl`
>
  <label
    for=`${checkBoxId}`
    class="h-full w-full flex items-center font-bold p-5! relative cursor-pointer"
  >
    <span class="dark:text-dark!">{label}</span>
  </label>
</div>
