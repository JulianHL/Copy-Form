---
const { id = "", placeholder = "", required = false } = Astro.props;
const phonePattern = String.raw`(?=(\D*\d){10,11})[\+0-9 \(\)\-]{10,20}`;
---

<div class="grid grid-cols-1 gap-5">
  <div>
    <label
      for=`${id}`
      class="font-bold text-[20px] flex items-center capitalize"
    >
      <span class="dark:text-dark!">{placeholder}</span>
      {
        required && (
          <span class="flex items-center h-full">
            <i class="fa-solid fa-asterisk text-[0.5em] before:text-[#ff757e]!" />
          </span>
        )
      }
    </label>
  </div>

  <input
    id={id}
    type="tel"
    name={id}
    data-required={required}
    placeholder=`Type ${placeholder} here...`
    pattern={phonePattern}
    class="w-full rounded-full p-5! transition-all duration-300 font-bold dark:text-dark!
    shadow-[5px_5px_10px_var(--shadow-color),-5px_-5px_10px_var(--light-color)] dark:shadow-[5px_5px_10px_var(--shadow-color-dark),-5px_-5px_10px_var(--light-color-dark)]
    focus:shadow-[inset_0_5px_4px_var(--shadow-color),0_3px_2px_var(--light-color)]
    dark:focus:shadow-[inset_0_5px_4px_var(--shadow-color-dark),inset_0_-3px_2px_var(--light-color-dark)]"
  />
</div>

<script>
  const telInputs = document.querySelectorAll(
    "input[type='tel']",
  ) as NodeListOf<HTMLInputElement>;

  telInputs.forEach((input) => {
    input.addEventListener("blur", () => {
      let numbers = input.value.replace(/[^\d+]/g, "");
      if (numbers.length > 7) {
        const countryCode = numbers.slice(0, -10);
        const areaCode = numbers.slice(-10, -7);
        const first = numbers.slice(-7, -4);
        const last = numbers.slice(-4);

        input.value = `${countryCode ? countryCode + " " : ""}(${areaCode}) ${first}-${last}`;
      }
    });
  });
</script>
